        "$value": {
          "colorSpace": "hsl",
          "components": [
            0,
            0,
            100
          ],
          "hex": "#ffffff"
        }
      },
      "foreground": {
        "$value": {
          "colorSpace": "hsl",
          "components": [
            222.2,
            84,
            4.9
          ],
          "hex": "#020817"
        }
      },
      "primary": {
        "$value": {
          "colorSpace": "hsl",
          "components": [
            222.2,
            47.4,
            11.2
          ],
          "hex": "#0f172a"
        }
      },
