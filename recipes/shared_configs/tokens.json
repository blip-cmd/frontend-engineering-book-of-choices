  },
  "radius": {
    "$type": "dimension",
    "lg": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      },
      "$description": "--radius in tokens.css."
    },
    "md": {
      "$value": {
        "value": 0.375,
        "unit": "rem"
      },
      "$description": "calc(var(--radius) - 2px) in tokens.css; equal to 0.375rem only at a 16px root font size."
    },
    "sm": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      },
      "$description": "calc(var(--radius) - 4px) in tokens.css; equal to 0.25rem only at a 16px root font size."
    }
  }
}
